{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["@playwright/test", "node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["playwright.config.ts", "global-setup.ts", "tests/**/*.ts"]
}
