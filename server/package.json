{
  "name": "server",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:test": "NODE_ENV=test bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "prisma:generate": "bunx --bun prisma generate",
    "prisma:migrate": "bunx --bun prisma migrate dev",
    "prisma:studio": "bunx --bun prisma studio",
    "prisma:seed": "bunx --bun prisma db seed",
    "db:test:migrate": "NODE_ENV=test bunx --bun prisma migrate deploy",
    "db:test:seed": "NODE_ENV=test bunx --bun prisma db seed"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.21.0",
    "prisma": "^7.9.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.6.29",
    "code": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "pg": "^8.23.0"
  }
}
