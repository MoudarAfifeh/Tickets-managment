DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ticket_management?schema=public"
PORT=3000

BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Origin of the client app, trusted by Better Auth for auth requests
TRUSTED_ORIGINS="http://localhost:5173"

# Shared secret for the inbound-email webhook: sent as the x-webhook-secret
# header (or ?secret= query param) to POST /api/webhooks/inbound-email.
# Not fatal if unset, but that endpoint returns 500 until it is.
WEBHOOK_SECRET="dev-webhook-secret"

# Used by prisma/seed.ts to create the initial admin user
ADMIN_EMAIL="admin@example.com"
# REPLACE with a strong, unique password before running the seed script
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
