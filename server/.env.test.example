# Copy to .env.test and fill in. Loaded automatically by Bun instead of
# .env whenever NODE_ENV=test (see server/package.json "dev:test"/"db:test:*"
# scripts) — this keeps e2e tests off the regular dev database.
#
# Run a SEPARATE, named `prisma dev` instance for this so it's a genuinely
# distinct database, not just a different schema on the dev one:
#   npx prisma dev --name test
# Paste the connection string it prints below (it changes on every fresh
# start of that instance, same as the dev one).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:PORT/template1?schema=public"

BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Origin of the client app, trusted by Better Auth for auth requests
TRUSTED_ORIGINS="http://localhost:5173"

# Shared secret for the inbound-email webhook (POST /api/webhooks/inbound-email)
WEBHOOK_SECRET="test-webhook-secret"

# Used by prisma/seed.ts to seed the admin user e2e tests log in as
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"

# Used by prisma/seed.ts to seed a non-admin (agent) user, for e2e coverage
# of non-admin route-guard/NavBar behavior
AGENT_EMAIL="agent@example.com"
AGENT_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"

# Deliberately blank (not omitted): Bun's NODE_ENV=test env loading overlays
# .env.test on top of .env rather than fully replacing it, so a var that's
# only in .env (e.g. server/.env's real OPENAI_API_KEY) still leaks through
# to NODE_ENV=test processes unless it's shadowed here. This keeps
# POST /api/tickets/:id/polish-reply deterministically "not configured" in tests.
OPENAI_API_KEY=""

PORT=3000
